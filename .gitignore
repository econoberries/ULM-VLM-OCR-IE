/src/evaluation/make_smoke_test.py

# Temporary outputs and logs
tmp/
temp/
logs/
*.log
*.out
*.err
*.tmp
# MiniCPM test runs (smoke file, single record); full-run results are committed
/results/minicpm/kie_en_smoke10_*
/results/minicpm/single_id*
